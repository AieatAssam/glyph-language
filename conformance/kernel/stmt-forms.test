--- source
fn show(a: Int, b: Int) io {
  print(a)
  print(b)
  return
}
fn two(): Int {
  return 2
}
fn main() io {
  let x = 1
  var y: Int = 2
  var w = 1
  w = w + x
  show(w, y)
  show(1, 2)
  show(two(), 3)
  return
}
