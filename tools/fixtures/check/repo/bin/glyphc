#!/usr/bin/env python3
# Fake compiler for check tests. Understands --version, check, build, fmt.
# A source containing the word ERROR fails with one fixable diagnostic.
import json, sys

MODULE = bytes.fromhex(
    "0061736d01000000"            # magic, version
    "010401600000"                # type section: () -> ()
    "03020100"                    # function section
    "0503010001"                  # memory section: min 1 page
    "0713"                        # export section, 19 bytes
    "02"
    "06" "6d656d6f7279" "02" "00"  # export memory
    "06" "5f7374617274" "00" "00"  # export _start
    "0a040102000b"                # code section: one empty body
)


def main(argv):
    if argv == ["--version"]:
        print("fake-glyphc 0.1")
        return 0
    cmd, path, rest = argv[0], argv[1], argv[2:]
    text = open(path, encoding="utf-8").read()
    bad = "ERROR" in text
    if cmd == "check":
        if bad:
            diag = {"code": "E0001", "severity": "error", "message": "bad word",
                    "span": {"file": path, "start": [1, 1], "end": [1, 6]},
                    "fix": {"description": "use ok", "edits": [
                        {"start": [1, 1], "end": [1, 6], "replacement": "ok"}]}}
            print(json.dumps(diag, sort_keys=True))
            return 1
        return 0
    if cmd == "build":
        if bad:
            print("build failed", file=sys.stderr)
            return 1
        out = rest[rest.index("-o") + 1]
        open(out, "wb").write(MODULE)
        return 0
    if cmd == "fmt":
        sys.stdout.write("\n".join(l.rstrip() for l in text.split("\n")).rstrip("\n") + "\n")
        return 0
    print("unknown command", cmd, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
